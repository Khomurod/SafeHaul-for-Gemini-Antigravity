rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // --- HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // ROBUST SUPER ADMIN CHECK (Aligned with Firestore)
    // BUG-1 FIX: Removed email-domain backdoor (@safehaul.io). 
    // Only custom claims determine Super Admin status.
    function isSuperAdmin() {
      return isSignedIn() && (
         (request.auth.token.keys().hasAny(['globalRole']) && request.auth.token.globalRole == 'super_admin') ||
         (request.auth.token.keys().hasAny(['roles']) && request.auth.token.roles.keys().hasAny(['globalRole']) && request.auth.token.roles.globalRole == 'super_admin')
      );
    }

    // COMPANY ADMIN CHECK
    function isCompanyAdmin(companyId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (
          request.auth.token.keys().hasAny(['roles']) && 
          request.auth.token.roles.keys().hasAny([companyId]) && 
          request.auth.token.roles[companyId] == 'company_admin'
        )
      );
    }

    function metadataDriverId() {
      return resource != null &&
             resource.metadata != null &&
             resource.metadata.driverId is string
             ? resource.metadata.driverId
             : null;
    }

    function incomingDriverId() {
      return request.resource != null &&
             request.resource.metadata != null &&
             request.resource.metadata.driverId is string
             ? request.resource.metadata.driverId
             : null;
    }

    function isDriverOwnedByMetadata() {
      return isSignedIn() && (
        (metadataDriverId() != null && request.auth.uid == metadataDriverId()) ||
        (incomingDriverId() != null && request.auth.uid == incomingDriverId())
      );
    }
    
    // VALIDATION
    function isValidFile() {
      // Allow images and PDFs, max 20MB (increased for high-quality envelopes)
      return request.resource.size < 20 * 1024 * 1024 &&
             request.resource.contentType.matches('application/pdf|image/.*');
    }

    // --- RULES ---

    // 1. Company Assets (Logos, Branding)
    // Public Read, Team Write
    match /company_assets/{companyId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isCompanyAdmin(companyId) && isValidFile();
      allow delete: if isCompanyAdmin(companyId);
    }

    // 2. Driver Private Documents
    match /drivers/{driverId}/{allPaths=**} {
      allow read, write: if isOwner(driverId) || isSuperAdmin();
    }

    // 3. Application Attachments (Guest Uploads)
    // Guests may upload only. Reads via getSignedGuestUploadUrl callable / company admin paths.
    match /companies/{companyId}/{folder}/guest_uploads/{allPaths=**} {
      allow read: if isCompanyAdmin(companyId) || isSuperAdmin();
      allow create: if (folder == 'applications' || folder == 'autofill') &&
                       isValidFile();
      // No delete or update permissions for guests
    }

    // Sensitive applicant document root: driver UID is path-bound.
    match /companies/{companyId}/applications/{driverId}/{allPaths=**} {
      allow read: if isOwner(driverId) || isCompanyAdmin(companyId) || isSuperAdmin();
      // Restricted to authenticated owner/company admin/super admin.
      // Guest uploads are only allowed in the dedicated guest_uploads path above.
      allow create, update: if isSuperAdmin() ||
                              (isSignedIn() && (isOwner(driverId) || isCompanyAdmin(companyId)) && isValidFile());
      allow delete: if isSuperAdmin() || 
                       (isSignedIn() && (isOwner(driverId) || isCompanyAdmin(companyId)));
    }

    // Metadata-owned files for non-driver-keyed paths (defense in depth).
    match /companies/{companyId}/{collection}/{applicationId}/{fileCategory}/{allPaths=**} {
      allow read: if isCompanyAdmin(companyId) || isSuperAdmin() || isDriverOwnedByMetadata();
      allow create, update: if isSuperAdmin() ||
                              (isSignedIn() && (isCompanyAdmin(companyId) || isDriverOwnedByMetadata()) && isValidFile());
      allow delete: if isSuperAdmin() ||
                       (isSignedIn() && (isCompanyAdmin(companyId) || isDriverOwnedByMetadata()));
    }

    // 4. Secure Documents (E-Signature Envelopes and Templates)
    // Path: secure_documents/{companyId}/{folder}/{fileName}
    match /secure_documents/{companyId}/{folder}/{allPaths=**} {
       // Read: Company Admin OR Super Admin. 
       // NOTE: Drivers/Recipients access these via generated Signed URLs from the backend.
       allow read: if isCompanyAdmin(companyId) || isSuperAdmin();
       
       // Write: Company Admin Only
       allow create, update: if isCompanyAdmin(companyId) && isValidFile();
       allow delete: if isCompanyAdmin(companyId);
    }

    // 5. PEV (Previous Employment Verification) Result Uploads
    // Path: companies/{companyId}/{collection}/{applicationId}/pev_results/{file}
    match /companies/{companyId}/{collection}/{applicationId}/pev_results/{fileName} {
      allow read: if isCompanyAdmin(companyId) || isSuperAdmin();
      allow create, update: if isCompanyAdmin(companyId) && isValidFile();
      allow delete: if isCompanyAdmin(companyId) || isSuperAdmin();
    }

    // 5b. PEV Signatures (Written by Cloud Functions via Admin SDK)
    // Path: companies/{companyId}/pev_signatures/{file}
    match /companies/{companyId}/pev_signatures/{fileName} {
      allow read: if isCompanyAdmin(companyId) || isSuperAdmin();
      allow write: if false; // Only Cloud Functions (Admin SDK) can write
    }

    // 6. System Health Tests
    match /system_health_tests/{fileName} {
      allow read, write: if isSuperAdmin();
    }
  }
}
