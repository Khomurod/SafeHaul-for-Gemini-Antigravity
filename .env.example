# =============================================================================
# SafeHaul — Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env or .env.local to version control.
# See README.md for full configuration instructions.
# =============================================================================

# --- Firebase (Web) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- reCAPTCHA Enterprise (Firebase App Check) ---
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# --- Sentry Error Monitoring ---
VITE_SENTRY_DSN=

# --- Facebook Lead Ads ---
VITE_FACEBOOK_APP_ID=

# --- Super Admin ---
# Used only as a fallback; primary auth is Firebase custom claims (globalRole = 'super_admin').
VITE_SUPER_ADMIN_EMAIL=

# --- Cloud Functions ---
# Replace with the deployed Cloud Run URL after deploying the functions.
PROCESS_BULK_BATCH_URL=
