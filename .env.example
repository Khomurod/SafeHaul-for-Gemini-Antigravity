VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# FMCSA employer autocomplete (Transportation.gov / Socrata — public app token, rate limits)
VITE_SOCRATA_APP_TOKEN=

# Facebook Lead Ads Integration
VITE_FACEBOOK_APP_ID=your-facebook-app-id

# Sentry Error Monitoring
VITE_SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/0

# Backend Configuration (Cloud Functions V2)
PROCESS_BULK_BATCH_URL=https://your-cloud-run-url.a.run.app

# App Check (reCAPTCHA Enterprise) - Bot Mitigation
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your-recaptcha-enterprise-site-key

# Primary auth should be Firebase Custom Claims (globalRole = 'super_admin').
VITE_SUPER_ADMIN_EMAIL=admin@your-company.com
